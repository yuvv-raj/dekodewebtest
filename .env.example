# Client-safe feature configuration only. Never put provider secrets in VITE_* variables.
VITE_DEKODE_VOICE_ENABLED=true
VITE_VOICE_PROVIDER=browser
VITE_VOICE_FALLBACK_ENABLED=true
VITE_MOCK_MEETING_SLOTS_ENABLED=true
VITE_COMPANY_TIMEZONE=Australia/Melbourne
VITE_LEAD_NOTIFICATION_MODE=mock
VITE_LEAD_NOTIFICATION_ENDPOINT=/api/leads
VITE_CLIENT_PROPOSALS_ENABLED=true
VITE_PROPOSAL_CHAT_ENABLED=true
VITE_PROPOSAL_ACCESS_MODE=password_only

# Server-only. Generate a long random value for each production environment.
# Never prefix this variable with VITE_.
PROPOSAL_SESSION_SECRET=
